# Telegram (https://my.telegram.org/apps para api_id/api_hash, @BotFather para el token)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=

# Opcional: IDs de Telegram autorizados, separados por comas.
# Vacío (por defecto) = cualquiera puede usar el bot (100% abierto).
# Ejemplo privado: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# Opcional: carpeta temporal de descargas / zips
DOWNLOAD_DIR=downloads

# SQLite: API keys de usuarios, preferencias (/expire, /dev) y jobs de resubida.
# Por defecto: <DOWNLOAD_DIR>/dripfiles_bot.db
# DATABASE_PATH=downloads/dripfiles_bot.db

# API key de DripFiles del bot. Todas las subidas la usan por defecto.
# Vacío = plan free (salvo key propia del usuario si ALLOW_USER_API_KEYS=true).
# DRIPFILES_API_KEY=df_xxxxxxxx_...

# Permitir que usuarios guarden su propia API key con /apikey (true/false).
# false = siempre la del bot (o free). Por defecto: true.
# ALLOW_USER_API_KEYS=true

# Mensaje/descripción del envío en DripFiles (visible en la página del link).
# Por defecto solo el nombre: el tamaño ya lo muestra DripFiles.
# Placeholders: {filename} {size} {count}
# DRIPFILES_MESSAGE={filename}

# Minutos sin actividad antes de cancelar una sesión /zip (por defecto 30)
ZIP_TIMEOUT_MINUTES=30

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
